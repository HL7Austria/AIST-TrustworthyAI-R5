Profile: Trust_AIObservation
Parent: Observation
Id: trust-ai-observation
Title: "Trust AI Generated Observation"
Description: "An Observation profile representing a clinical output generated by an AI system, including AI-related transparency metadata and links to the relevant patient, encounter, and AI system."

// =======================================================
//  STATUS & BASICS
// =======================================================
* subject 1..1 MS

// SYS-10.1
* effective[x] 1..1 MS
* effective[x] only dateTime
* effectiveDateTime ^short = "Time the AI generated this result"

// =======================================================
//  DEVICE LINK 
// =======================================================
* device 1..1 MS
* device only Reference(Trust_AIDevice)
* device ^short = "Link to the AI Device that generated this result"

// =======================================================
//  AI-GENERATED FLAG (AI origin transparency)
// =======================================================
* interpretation
* interpretation ^slicing.discriminator.type = #value
* interpretation ^slicing.discriminator.path = "coding"
* interpretation ^slicing.rules = #open
* interpretation contains aiGeneratedFlag 1..1 MS
* interpretation[aiGeneratedFlag].coding = TrustAIInvolvementCodeSystem#ai-generated
* interpretation[aiGeneratedFlag] ^short = "Mandatory flag indicating AI origin"
// TODO: find the law for the nessesary mark

// =======================================================
// EXTENSIONS (USE-04 (GDPR Art. 5 | Case-Specific Indication) & Law-02 (GDPR Art. 22 | Automated Decision Flag))
// =======================================================
//* extension contains
//    CaseSpecificIndication named caseIndication 1..1 MS and
//    AutomatedDecisionFlag named automatedDecision 1..1 MS
//
//* extension[caseIndication] ^short = "Clinical reason for AI use"
//* extension[automatedDecision] ^short = "Automated decision flag"